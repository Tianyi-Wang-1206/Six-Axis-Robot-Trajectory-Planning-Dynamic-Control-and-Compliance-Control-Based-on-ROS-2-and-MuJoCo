  <description>Debugging motion planner adapter and event-supervised execution node backed by lite6_studio_planner.</description>
  <maintainer email="developer@robot.local">developer</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>lite6_interfaces</depend>

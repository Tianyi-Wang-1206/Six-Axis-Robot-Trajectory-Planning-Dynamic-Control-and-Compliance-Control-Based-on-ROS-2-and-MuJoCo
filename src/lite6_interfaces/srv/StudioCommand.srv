# Industrial execution state machine event request for lite6_studio_planner.
uint8 CMD_RUN=1
uint8 CMD_PAUSE=2
uint8 CMD_RESUME=3
uint8 CMD_STEP=4
uint8 CMD_STOP=5
uint8 CMD_ESTOP=6
uint8 CMD_RESET_FAULT=7
uint8 CMD_RECOVER=8
uint8 CMD_CLEAR_PROGRAM=9

uint8 command
# Optional optimistic planner incarnation and revision guards:
# 0 skips the respective check (CMD_ESTOP always bypasses both guards).
uint64 expected_planner_epoch 0
uint64 expected_revision 0
string reason
---
bool accepted
uint64 planner_epoch
uint64 revision
uint8 state
uint64 controller_epoch
string message

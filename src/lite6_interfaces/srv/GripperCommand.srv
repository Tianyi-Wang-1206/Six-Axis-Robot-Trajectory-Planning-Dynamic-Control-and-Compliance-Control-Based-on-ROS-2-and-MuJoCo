uint8 OPEN=1
uint8 CLOSE=2
uint8 STOP=3
uint8 command
# Independent OPEN/CLOSE/STOP. Calibration is loaded from gripper.yaml at startup.
# STOP removes motor drive; it does not impose a position lock or guarantee a grasp.
---
# Accepted into the physics queue, not a claim of physical completion.
bool accepted
uint64 sequence
string detail

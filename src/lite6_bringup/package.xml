<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lite6_bringup</name>
  <version>0.0.0</version>
  <description>Bringup launch configurations for the Robot simulation and control stack.</description>
  <maintainer email="developer@robot.local">developer</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>ros2_control</exec_depend>
  <exec_depend>lite6_hardware</exec_depend>
  <exec_depend>lite6_kinematics</exec_depend>
  <exec_depend>lite6_planner</exec_depend>
  <exec_depend>lite6_hmi</exec_depend>
  <exec_depend>lite6_studio_planner</exec_depend>
  <exec_depend>lite6_studio_hmi</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

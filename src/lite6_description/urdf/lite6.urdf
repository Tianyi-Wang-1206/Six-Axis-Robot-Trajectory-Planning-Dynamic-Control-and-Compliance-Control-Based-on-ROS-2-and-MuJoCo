<?xml version="1.0" ?>
<robot name="lite6">
  <material name="White">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>
  <material name="Silver">
    <color rgba="0.753 0.753 0.753 1.0"/>
  </material>

  <material name="Black"><color rgba="0.1 0.1 0.1 1"/></material>

  <!-- ==================== LINKS & JOINTS ==================== -->
  <link name="link_base">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.00829545 3.26357e-05 0.0631195"/>
      <mass value="1.65394"/>
      <inertia ixx="0.0" ixy="0" ixz="0" iyy="0.0" iyz="0" izz="0.0"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://lite6_description/mujoco/assets/visual/link_base.stl"/></geometry>
      <material name="White"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://lite6_description/mujoco/assets/collision/link_base.stl"/></geometry>
    </collision>
  </link>

  <link name="link1">
    <inertial>
      <origin rpy="1.8343678787714683 -0.089717113459464315 -0.041887650406745136" xyz="-0.00036 0.04195 -0.0025"/>
      <mass value="1.411"/>
      <inertia ixx="0.00145276" ixy="0" ixz="0" iyy="0.00135275" iyz="0" izz="0.000853355"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://lite6_description/mujoco/assets/visual/link1.stl"/></geometry>
      <material name="White"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://lite6_description/mujoco/assets/collision/link1.stl"/></geometry>
    </collision>
  </link>

  <joint name="joint1" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 0.2435"/>
    <parent link="link_base"/>
    <child link="link1"/>
    <axis xyz="0 0 1"/>
    <limit effort="50.0" lower="-6.28319" upper="6.28319" velocity="3.14"/>
    <dynamics damping="0" friction="0"/>
  </joint>

  <link name="link2">
    <inertial>
      <origin rpy="1.8779547130557748 -0.0018495466474293121 1.5685853657693354" xyz="0.179 0 0.0584"/>
      <mass value="1.34"/>
      <inertia ixx="0.00560971" ixy="0" ixz="0" iyy="0.0052152" iyz="0" izz="0.00122018"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://lite6_description/mujoco/assets/visual/link2.stl"/></geometry>
      <material name="White"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://lite6_description/mujoco/assets/collision/link2.stl"/></geometry>
    </collision>
  </link>

  <joint name="joint2" type="revolute">
    <origin rpy="-1.5707963267948966 -1.5707963267948966 0" xyz="0 0 0"/>
    <parent link="link1"/>
    <child link="link2"/>
    <axis xyz="0 0 1"/>
    <limit effort="50.0" lower="-2.61799" upper="2.61799" velocity="3.14"/>
    <dynamics damping="0" friction="0"/>
  </joint>

  <link name="link3">
    <inertial>
      <origin rpy="-0.82404816147354976 -1.4749400089131401 -2.7390598181156269" xyz="0.072 -0.0357 -0.001"/>
      <mass value="0.953"/>
      <inertia ixx="0.0018521" ixy="0" ixz="0" iyy="0.00175546" iyz="0" izz="0.000703807"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://lite6_description/mujoco/assets/visual/link3.stl"/></geometry>
      <material name="White"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://lite6_description/mujoco/assets/collision/link3.stl"/></geometry>
    </collision>
  </link>

  <joint name="joint3" type="revolute">
    <origin rpy="3.1415853071858217 1.4419576643831533e-12 1.5708005694372709" xyz="0.2002 0 0"/>
    <parent link="link2"/>
    <child link="link3"/>
    <axis xyz="0 0 1"/>
    <limit effort="32.0" lower="0.0" upper="4.97419" velocity="3.14"/>
    <dynamics damping="0" friction="0"/>
  </joint>

  <link name="link4">
    <inertial>
      <origin rpy="0.44585556070553134 0.0051285391300999184 -0.0042140098791418612" xyz="-0.002 -0.0285 -0.0813"/>
      <mass value="1.284"/>
      <inertia ixx="0.00370503" ixy="0" ixz="0" iyy="0.00349091" iyz="0" izz="0.00109586"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://lite6_description/mujoco/assets/visual/link4.stl"/></geometry>
      <material name="White"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://lite6_description/mujoco/assets/collision/link4.stl"/></geometry>
    </collision>
  </link>

  <joint name="joint4" type="revolute">
    <origin rpy="1.5708005694372709 0 0" xyz="0.087 -0.22761 0"/>
    <parent link="link3"/>
    <child link="link4"/>
    <axis xyz="0 0 1"/>
    <limit effort="32.0" lower="-6.28319" upper="6.28319" velocity="3.14"/>
    <dynamics damping="0" friction="0"/>
  </joint>

  <link name="link5">
    <inertial>
      <origin rpy="1.5461249342360066 -0.14009190932019511 -0.0088934126964300697" xyz="0 0.01 0.0019"/>
      <mass value="0.804"/>
      <inertia ixx="0.000567553" ixy="0" ixz="0" iyy="0.000529266" iyz="0" izz="0.000507681"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://lite6_description/mujoco/assets/visual/link5.stl"/></geometry>
      <material name="White"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://lite6_description/mujoco/assets/collision/link5.stl"/></geometry>
    </collision>
  </link>

  <joint name="joint5" type="revolute">
    <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
    <parent link="link4"/>
    <child link="link5"/>
    <axis xyz="0 0 1"/>
    <limit effort="32.0" lower="-1.62316" upper="1.62316" velocity="3.14"/>
    <dynamics damping="0" friction="0"/>
  </joint>

  <link name="link6">
    <inertial>
      <origin rpy="1.1496493139014901 -1.5595093355955245 2.1083810819052897" xyz="0 -0.00194 -0.0102"/>
      <mass value="0.13"/>
      <inertia ixx="0.000148148" ixy="0" ixz="0" iyy="8.57757e-05" iyz="0" izz="7.71412e-05"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://lite6_description/mujoco/assets/visual/link6.stl"/></geometry>
      <material name="Silver"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://lite6_description/mujoco/assets/collision/link6.stl"/></geometry>
    </collision>
  </link>

  <joint name="joint6" type="revolute">
    <origin rpy="-1.5707963267948966 0 0" xyz="0 0.0625 0"/>
    <parent link="link5"/>
    <child link="link6"/>
    <axis xyz="0 0 1"/>
    <limit effort="20.0" lower="-6.28319" upper="6.28319" velocity="3.14"/>
    <dynamics damping="0" friction="0"/>
  </joint>

  <!-- Wide gripper: MuJoCo Menagerie, see mujoco/MODEL_SOURCES.md. -->
<link name="gripper_body"><inertial><origin xyz="0.0 0.0 0.026" rpy="0 0 0" /><mass value="0.26" /><inertia ixx="0.00016117" iyy="0.000118" izz="0.00014455" ixy="0" ixz="0" iyz="0" /></inertial><visual><geometry><mesh filename="package://lite6_description/mujoco/assets/visual/gripper_lite_body.stl" /></geometry><material name="White" /></visual><collision><geometry><mesh filename="package://lite6_description/mujoco/assets/collision/gripper_lite_body.stl" /></geometry></collision></link>
<joint name="gripper_mount" type="fixed"><parent link="link6" /><child link="gripper_body" /><origin xyz="0 0 0" rpy="0 0 0" /></joint>
<link name="gripper_left_finger"><inertial><origin xyz="0.0 -0.01 0.01" rpy="0 0 0" /><mass value="0.024" /><inertia ixx="1.961e-6" iyy="2.274e-6" izz="1.238e-6" ixy="0" ixz="0" iyz="0" /></inertial><visual><geometry><mesh filename="package://lite6_description/mujoco/assets/visual/gripper_lite_left_finger_wide.stl" /></geometry><material name="Black" /></visual><collision><geometry><mesh filename="package://lite6_description/mujoco/assets/collision/gripper_lite_left_finger_wide_base.stl" /></geometry></collision><collision><geometry><mesh filename="package://lite6_description/mujoco/assets/collision/gripper_lite_left_finger_wide_tip.stl" /></geometry></collision></link>
<joint name="gripper_left_finger" type="prismatic"><parent link="gripper_body" /><child link="gripper_left_finger" /><origin xyz="0 0 0.054" rpy="0 0 0" /><axis xyz="0 1 0" /><limit lower="-0.0081" upper="-1e-5" effort="10" velocity="0.05" /><dynamics damping="0" friction="0.4" /></joint>
<link name="gripper_right_finger"><inertial><origin xyz="0.0 0.01 0.01" rpy="0 0 0" /><mass value="0.024" /><inertia ixx="1.961e-6" iyy="2.274e-6" izz="1.238e-6" ixy="0" ixz="0" iyz="0" /></inertial><visual><geometry><mesh filename="package://lite6_description/mujoco/assets/visual/gripper_lite_right_finger_wide.stl" /></geometry><material name="Black" /></visual><collision><geometry><mesh filename="package://lite6_description/mujoco/assets/collision/gripper_lite_right_finger_wide_base.stl" /></geometry></collision><collision><geometry><mesh filename="package://lite6_description/mujoco/assets/collision/gripper_lite_right_finger_wide_tip.stl" /></geometry></collision></link>
<joint name="gripper_right_finger" type="prismatic"><parent link="gripper_body" /><child link="gripper_right_finger" /><origin xyz="0 0 0.054" rpy="0 0 0" /><axis xyz="0 1 0" /><limit lower="1e-5" upper="0.0081" effort="10" velocity="0.05" /><dynamics damping="0" friction="0.4" /></joint>
  <link name="link_eef"/>
  <joint name="joint_eef" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.0811"/>
    <parent link="link6"/>
    <child link="link_eef"/>
  </joint>

  <!-- ==================== ROS 2 CONTROL CONFIGURATION ==================== -->
  <ros2_control name="Lite6MuJoCo" type="system">
    <hardware>
      <plugin>lite6_hardware/Lite6MujocoSystem</plugin>
      <!-- Independent 10 kHz physics thread. FIFO is attempted when permitted;
           set 0 for normal scheduling. Check /simulation/diagnostics for lag. -->
      <param name="physics_thread_priority">60</param>
    </hardware>

    <!-- Joint 1 -->
    <joint name="joint1">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <!-- Joint 2 -->
    <joint name="joint2">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <!-- Joint 3 -->
    <joint name="joint3">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <!-- Joint 4 -->
    <joint name="joint4">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <!-- Joint 5 -->
    <joint name="joint5">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <!-- Joint 6 -->
    <joint name="joint6">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <!-- State-only feedback for the independent gripper. -->
    <joint name="gripper_left_finger">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="acceleration"/>
      <state_interface name="effort"/>
    </joint>
    <!-- State-only feedback for the independent gripper. -->
    <joint name="gripper_right_finger">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="acceleration"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>
</robot>

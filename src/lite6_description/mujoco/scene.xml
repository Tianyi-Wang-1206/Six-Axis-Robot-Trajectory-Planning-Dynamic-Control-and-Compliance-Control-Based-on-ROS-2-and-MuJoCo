<mujoco model="Lite6 | Warm Studio">
  <!-- The robot model is included unchanged. -->
  <include file="lite6.xml"/>

  <!-- Keep the robot base at z=0. Bench top stays at z=0; floor stays at z=-0.8. -->
  <statistic center="0.10 0 0.16" extent="1.45"/>

  <visual>
    <global azimuth="135" elevation="-22" offwidth="1920" offheight="1080"/>
    <quality shadowsize="4096" offsamples="8" numslices="48" numstacks="24"/>
    <headlight diffuse="0.16 0.16 0.16" ambient="0.32 0.32 0.32"
               specular="0.03 0.03 0.03"/>
    <rgba haze="0.88 0.90 0.91 1"/>
    <map znear="0.01" zfar="30" fogstart="6" fogend="18"/>
  </visual>

  <asset>
    <!-- Soft daylight background. No external image files are required. -->
    <texture name="studio_sky" type="skybox" builtin="gradient"
             rgb1="0.72 0.82 0.90" rgb2="0.94 0.94 0.91"
             width="256" height="1536"/>

    <!-- Low-contrast floor grid, with alpha controlled by studio_floor. -->
    <texture name="floor_grid" type="2d" builtin="checker" mark="edge"
             rgb1="0.84 0.88 0.90" rgb2="0.88 0.91 0.92"
             markrgb="0.73 0.79 0.82" width="512" height="512"/>
    <material name="studio_floor" texture="floor_grid" texuniform="true"
              texrepeat="2 2" rgba="1 1 1 0.78"
              reflectance="0.02" shininess="0.10" specular="0.06"/>

    <!-- Warm oak tabletop and anthracite steel supports. -->
    <material name="worktop" rgba="0.72 0.58 0.44 1" shininess="0.16" specular="0.10"/>
    <material name="wood_edge" rgba="0.56 0.42 0.31 1" shininess="0.14" specular="0.08"/>
    <material name="frame" rgba="0.24 0.28 0.30 1" shininess="0.22" specular="0.18"/>
    <material name="trim" rgba="0.41 0.50 0.49 1" shininess="0.16" specular="0.10"/>

    <!-- Warm ivory plaster, cool wainscot, and dark-framed glazing. -->
    <material name="wall" rgba="0.90 0.89 0.86 1" specular="0.03"/>
    <material name="wall_lower" rgba="0.79 0.81 0.80 1" specular="0.03"/>
    <material name="wall_trim" rgba="0.92 0.91 0.87 1" specular="0.08"/>
    <material name="window_frame" rgba="0.22 0.27 0.30 1"
              shininess="0.32" specular="0.25"/>
    <material name="window_glass" rgba="0.75 0.86 0.92 0.20"
              shininess="0.85" specular="0.60"/>
    <material name="window_sill" rgba="0.64 0.55 0.45 1"
              shininess="0.15" specular="0.10"/>
  </asset>

  <default>
    <!-- All architectural detail is visual only, just like the original scene. -->
    <default class="studio_decor">
      <geom contype="0" conaffinity="0" group="1"/>
    </default>
  </default>

  <worldbody>
    <!-- Soft key light and cool fill light: preserve detail on white robot links. -->
    <light pos="-1.3 -2.0 3.6" dir="0.30 0.42 -1" directional="false"
           cutoff="65" exponent="1" diffuse="0.45 0.42 0.38"
           specular="0.06 0.06 0.06" castshadow="true"/>
    <light pos="1.5 1.0 2.6" dir="-0.40 -0.35 -1" directional="true"
           diffuse="0.19 0.23 0.27" specular="0.03 0.03 0.03"
           castshadow="false"/>

    <!-- Ground contact unchanged: plane is at z=-0.8. -->
    <geom name="floor" type="plane" pos="0 0 -0.8" size="0 0 0.05"
          material="studio_floor"/>

    <!-- Original 2.4 x 1.5 m bench. Its TOP surface is exactly z=0. -->
    <geom name="workbench_top" type="box" pos="0.3 0 -0.045"
          size="1.2 0.75 0.045" material="worktop"/>
    <!-- Movable grasp objects: SI units; bottoms rest on the z=0 tabletop.
         Physical contacts are required for support and gripping. These scene
         bodies are not part of the planner's URDF collision model. -->
    <body name="grasp_cylinder" pos="0.30 -0.12 0.05">
      <freejoint name="grasp_cylinder_free"/>
      <!-- Diameter 30 mm, height 100 mm, mass 500 g. -->
      <geom name="grasp_cylinder_geom" type="cylinder" size="0.015 0.05"
            group="4" mass="0.5" rgba="0.23 0.48 0.72 1" condim="4"
            friction="1 0.005 0.0001"/>
    </body>
    <body name="grasp_box" pos="0.30 0.12 0.04">
      <freejoint name="grasp_box_free"/>
      <!-- 40 x 30 x 80 mm, mass 300 g; grip across the 30 mm width. -->
      <geom name="grasp_box_geom" type="box" size="0.02 0.015 0.04"
            group="4" mass="0.3" rgba="0.82 0.43 0.18 1" condim="4"
            friction="1 0.005 0.0001"/>
    </body>
    <geom class="studio_decor" type="box" pos="0.3 0 -0.105"
          size="1.16 0.71 0.015" material="frame"/>

    <!-- Thin oak edge banding. It is visual-only, so collision is unchanged. -->
    <geom class="studio_decor" type="box" pos="0.3 -0.754 -0.047"
          size="1.2 0.006 0.030" material="wood_edge"/>
    <geom class="studio_decor" type="box" pos="0.3 0.754 -0.047"
          size="1.2 0.006 0.030" material="wood_edge"/>
    <geom class="studio_decor" type="box" pos="-0.904 0 -0.047"
          size="0.006 0.75 0.030" material="wood_edge"/>
    <geom class="studio_decor" type="box" pos="1.504 0 -0.047"
          size="0.006 0.75 0.030" material="wood_edge"/>
    <geom class="studio_decor" type="box" pos="0.3 -0.763 -0.068"
          size="1.12 0.003 0.003" material="trim"/>

    <!-- Original frame locations and dimensions retained. -->
    <geom class="studio_decor" type="box" pos="-0.75 -0.6 -0.445"
          size="0.045 0.045 0.355" material="frame"/>
    <geom class="studio_decor" type="box" pos="1.35 -0.6 -0.445"
          size="0.045 0.045 0.355" material="frame"/>
    <geom class="studio_decor" type="box" pos="-0.75 0.6 -0.445"
          size="0.045 0.045 0.355" material="frame"/>
    <geom class="studio_decor" type="box" pos="1.35 0.6 -0.445"
          size="0.045 0.045 0.355" material="frame"/>
    <geom class="studio_decor" type="box" pos="0.3 0.6 -0.62"
          size="1.05 0.025 0.035" material="frame"/>

    <!-- Wall below and above the two window openings. -->
    <geom class="studio_decor" type="box" pos="0 3 -0.175"
          size="5 0.08 0.625" material="wall"/>
    <geom class="studio_decor" type="box" pos="0 3 2.45"
          size="5 0.08 0.25" material="wall"/>

    <!-- Solid left, middle and right piers separating the openings. -->
    <geom class="studio_decor" type="box" pos="-3.625 3 1.325"
          size="1.375 0.08 0.875" material="wall"/>
    <geom class="studio_decor" type="box" pos="0 3 1.325"
          size="0.35 0.08 0.875" material="wall"/>
    <geom class="studio_decor" type="box" pos="3.625 3 1.325"
          size="1.375 0.08 0.875" material="wall"/>

    <!-- Slightly cool wall panel below windows, plus architectural trims. -->
    <geom class="studio_decor" type="box" pos="0 2.912 -0.23"
          size="4.98 0.009 0.49" material="wall_lower"/>
    <geom class="studio_decor" type="box" pos="0 2.894 0.275"
          size="4.99 0.016 0.019" material="wall_trim"/>
    <geom class="studio_decor" type="box" pos="0 2.893 -0.73"
          size="4.99 0.018 0.052" material="wall_trim"/>
    <geom class="studio_decor" type="box" pos="0 2.894 2.48"
          size="4.99 0.015 0.018" material="wall_trim"/>

    <!-- Glass is genuinely translucent and does not fill the gap with a wall. -->
    <geom class="studio_decor" type="box" pos="-1.30 3.00 1.325"
          size="0.923 0.004 0.843" material="window_glass"/>
    <geom class="studio_decor" type="box" pos="1.30 3.00 1.325"
          size="0.923 0.004 0.843" material="window_glass"/>

    <!-- Left window: four dark perimeter bars, plus mullions. -->
    <geom class="studio_decor" type="box" pos="-2.25 2.900 1.325"
          size="0.037 0.042 0.895" material="window_frame"/>
    <geom class="studio_decor" type="box" pos="-0.35 2.900 1.325"
          size="0.037 0.042 0.895" material="window_frame"/>
    <geom class="studio_decor" type="box" pos="-1.30 2.900 0.45"
          size="0.970 0.042 0.036" material="window_frame"/>
    <geom class="studio_decor" type="box" pos="-1.30 2.900 2.20"
          size="0.970 0.042 0.036" material="window_frame"/>
    <geom class="studio_decor" type="box" pos="-1.30 2.855 1.325"
          size="0.020 0.022 0.850" material="window_frame"/>
    <geom class="studio_decor" type="box" pos="-1.30 2.855 1.325"
          size="0.930 0.022 0.020" material="window_frame"/>

    <!-- Right window: symmetric matching frame and crossbars. -->
    <geom class="studio_decor" type="box" pos="0.35 2.900 1.325"
          size="0.037 0.042 0.895" material="window_frame"/>
    <geom class="studio_decor" type="box" pos="2.25 2.900 1.325"
          size="0.037 0.042 0.895" material="window_frame"/>
    <geom class="studio_decor" type="box" pos="1.30 2.900 0.45"
          size="0.970 0.042 0.036" material="window_frame"/>
    <geom class="studio_decor" type="box" pos="1.30 2.900 2.20"
          size="0.970 0.042 0.036" material="window_frame"/>
    <geom class="studio_decor" type="box" pos="1.30 2.855 1.325"
          size="0.020 0.022 0.850" material="window_frame"/>
    <geom class="studio_decor" type="box" pos="1.30 2.855 1.325"
          size="0.930 0.022 0.020" material="window_frame"/>

    <!-- Slim wooden sills project slightly into the room. -->
    <geom class="studio_decor" type="box" pos="-1.30 2.825 0.43"
          size="0.995 0.117 0.027" material="window_sill"/>
    <geom class="studio_decor" type="box" pos="1.30 2.825 0.43"
          size="0.995 0.117 0.027" material="window_sill"/>
  </worldbody>
</mujoco>

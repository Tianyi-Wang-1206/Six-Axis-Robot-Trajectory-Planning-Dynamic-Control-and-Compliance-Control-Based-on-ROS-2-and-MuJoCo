<mujoco model="Lite6 | Studio">
  <include file="lite6.xml"/>

  <!-- Base frame stays at z=0; the 80 cm workbench is built below it. -->
  <statistic center="0.08 0 0.14" extent="1.15"/>
  <visual>
    <global azimuth="135" elevation="-22" offwidth="1920" offheight="1080"/>
    <quality shadowsize="4096" offsamples="8" numslices="48" numstacks="24"/>
    <headlight diffuse="0.18 0.18 0.18" ambient="0.3 0.3 0.3" specular="0.02 0.02 0.02"/>
    <rgba haze="0.82 0.83 0.81 1"/>
    <map znear="0.01" zfar="30" fogstart="5" fogend="15"/>
  </visual>

  <asset>
    <texture name="studio_sky" type="skybox" builtin="gradient"
      rgb1="0.78 0.82 0.84" rgb2="0.9 0.89 0.86" width="256" height="1536"/>
    <texture name="floor_grid" type="2d" builtin="checker" mark="edge"
      rgb1="0.65 0.67 0.66" rgb2="0.68 0.7 0.69" markrgb="0.6 0.63 0.62"
      width="512" height="512"/>
    <material name="studio_floor" texture="floor_grid" texuniform="true"
      texrepeat="1 1" reflectance="0" shininess="0.1" specular="0.05"/>
    <material name="worktop" rgba="0.61 0.64 0.63 1" shininess="0.15" specular="0.08"/>
    <material name="frame" rgba="0.43 0.47 0.46 1" shininess="0.15" specular="0.08"/>
    <material name="trim" rgba="0.48 0.58 0.55 1" specular="0.05"/>
    <material name="wall" rgba="0.86 0.85 0.82 1" specular="0.05"/>
    <material name="panel" rgba="0.78 0.8 0.78 1" specular="0.05"/>
  </asset>
  <default>
    <default class="studio_decor">
      <geom contype="0" conaffinity="0" group="1"/>
    </default>
  </default>
  <worldbody>
    <!-- Gentle key and fill lighting keeps the white shell below clipping. -->
    <light pos="-1 -2 3.5" dir="0.3 0.4 -1" directional="false" cutoff="65" exponent="1"
      diffuse="0.42 0.41 0.39" specular="0.05 0.05 0.05" castshadow="true"/>
    <light pos="1.5 1 2" dir="-0.4 -0.3 -1" directional="true"
      diffuse="0.18 0.19 0.2" specular="0.02 0.02 0.02" castshadow="false"/>
    <geom name="floor" type="plane" pos="0 0 -0.8" size="0 0 0.05" material="studio_floor"/>
    <!-- 2.4 x 1.5 m tabletop, top surface coincident with robot base. -->
    <geom name="workbench_top" type="box" pos="0.3 0 -0.045" size="1.2 0.75 0.045" material="worktop"/>
    <geom class="studio_decor" type="box" pos="0.3 0 -0.105" size="1.16 0.71 0.015" material="frame"/>
    <geom class="studio_decor" type="box" pos="0.3 -0.752 -0.055" size="1.12 0.003 0.006" material="trim"/>
    <geom class="studio_decor" type="box" pos="-0.75 -0.6 -0.445" size="0.045 0.045 0.355" material="frame"/>
    <geom class="studio_decor" type="box" pos="1.35 -0.6 -0.445" size="0.045 0.045 0.355" material="frame"/>
    <geom class="studio_decor" type="box" pos="-0.75 0.6 -0.445" size="0.045 0.045 0.355" material="frame"/>
    <geom class="studio_decor" type="box" pos="1.35 0.6 -0.445" size="0.045 0.045 0.355" material="frame"/>
    <geom class="studio_decor" type="box" pos="0.3 0.6 -0.62" size="1.05 0.025 0.035" material="frame"/>
    <!-- Architectural background: static primitives, no extra dynamics or textures. -->
    <geom class="studio_decor" type="box" pos="0 3 0.95" size="5 0.08 1.75" material="wall"/>
    <geom class="studio_decor" type="box" pos="-2 2.9 0.75" size="0.65 0.025 1.1" material="panel"/>
    <geom class="studio_decor" type="box" pos="0 2.9 0.75" size="0.65 0.025 1.1" material="panel"/>
    <geom class="studio_decor" type="box" pos="2 2.9 0.75" size="0.65 0.025 1.1" material="panel"/>
    <geom class="studio_decor" type="box" pos="0 2.86 2" size="3.2 0.008 0.012" material="trim"/>
  </worldbody>
</mujoco>

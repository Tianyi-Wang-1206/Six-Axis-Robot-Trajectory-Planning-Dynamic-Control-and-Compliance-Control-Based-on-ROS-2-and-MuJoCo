<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lite6_studio_planner</name>
  <version>0.1.0</version>
  <description>Industrial trajectory programming DSL compiler, self-developed time-optimal planner, and execution supervisor for Lite6.</description>
  <maintainer email="developer@lite6.local">Lite6 Studio Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>control_msgs</depend>
  <depend>ament_index_cpp</depend>
  <depend>lite6_interfaces</depend>
  <depend>lite6_planner</depend>
  <depend>lite6_description</depend>
  <depend>yaml-cpp</depend>
  <depend>pinocchio</depend>
  <depend>coal</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
